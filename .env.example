# Copia este archivo como .env (sin ".example") y ajusta con tus
# credenciales reales. .env NUNCA debe subirse a GitHub
# (agrégalo a tu .gitignore).

DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/photocheck

# Clave secreta para firmar los tokens de sesión (JWT). Pon cualquier
# cadena larga y aleatoria — por ejemplo, genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-por-algo-aleatorio-y-largo

# Opcional: solo necesaria para que la IA clasifique las novedades (Fase 6).
# Consíguela en https://console.anthropic.com/settings/keys
# Si la dejas vacía, el sistema sigue funcionando normal, solo omite esa parte.
ANTHROPIC_API_KEY=
